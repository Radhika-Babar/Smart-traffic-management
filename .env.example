# Everything here is local. The project uses no third-party services or API keys.
# Copy to .env only if you need to change a default.

APP_ENV=development
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Default is a SQLite file in backend/data. For local PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://traffic:traffic@127.0.0.1:5432/traffic

MQTT_ENABLED=true
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Simulated seconds per tick
SIMULATION_INTERVAL=0.5
SIMULATION_AUTOSTART=true
SEED_HISTORY_DAYS=14
